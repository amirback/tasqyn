# ─────────────────────────────────────────────────────────────
#  Tasqyn — переменные окружения
#  Ничего из этого НЕ обязательно для локального запуска.
#  Без этого файла приложение работает на локальной базе data/tasqyn.db
# ─────────────────────────────────────────────────────────────

# База данных в облаке (Turso — бесплатный тариф). Нужно только для деплоя.
# Как получить: turso.tech → создать базу → скопировать URL и токен.
# TURSO_DATABASE_URL=libsql://tasqyn-xxxx.turso.io
# TURSO_AUTH_TOKEN=eyJhbGci...

# Пароль для входа в панель ДЧС (/dashboard). По умолчанию: tasqyn
# DASHBOARD_PASSWORD=tasqyn
